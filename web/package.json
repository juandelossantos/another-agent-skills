{
  "name": "another-agent-skills-web",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Public landing (and later docs) for Another Agent Skills. Build-free core, Astro only in web/.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "og": "node scripts/generate-og.mjs",
    "preview": "astro preview",
    "test": "astro build && node --test tests/build.test.mjs tests/seo.test.mjs",
    "test:e2e": "astro build && playwright test",
    "test:all": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0"
  }
}
