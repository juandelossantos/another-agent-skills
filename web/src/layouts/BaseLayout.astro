---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { HTML_LANG, type Dictionary, type Locale } from '../i18n';
import { alternateLocale, BASE, localePath } from '../i18n/routes';

interface Props {
  locale: Locale;
  dict: Dictionary;
  title?: string;
  description?: string;
  /** Logical path inside the locale (default: the landing root). */
  canonicalPath?: string;
  /** Structured data (one object or an array of objects). */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  locale,
  dict,
  title = dict.meta.title,
  description = dict.meta.description,
  canonicalPath = '',
  jsonLd,
} = Astro.props;

const site = Astro.site ?? new URL('https://juandelossantos.github.io');
const altLocale = alternateLocale(locale);

const absolute = (path: string) => new URL(path, site).href;
const canonical = absolute(localePath(locale, canonicalPath));
const enHref = absolute(localePath('en', canonicalPath));
const esHref = absolute(localePath('es', canonicalPath));
const ogImage = absolute(`${BASE}og.png`);

const jsonLdBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang={HTML_LANG[locale]} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <meta name="generator" content={Astro.generator} />

    <!-- Apply theme + JS flag before paint (no flash). Respects prefers-color-scheme on first load. -->
    <script is:inline>
      (function () {
        var doc = document.documentElement;
        doc.setAttribute('data-js', 'true');
        var theme;
        try { theme = localStorage.getItem('aas-theme'); } catch (e) {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        }
        doc.setAttribute('data-theme', theme);
      })();
    </script>

    <!-- Canonical + hreflang (EN default, ES prefixed) -->
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="es" href={esHref} />
    <link rel="alternate" hreflang="x-default" href={enHref} />

    <!-- Icons -->
    <link rel="icon" href={`${BASE}favicon.svg`} type="image/svg+xml" />

    <!-- Open Graph / Twitter (og.png is a placeholder to be replaced with a real card) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Another Agent Skills" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'es' ? 'es_ES' : 'en_US'} />
    <meta property="og:locale:alternate" content={locale === 'es' ? 'en_US' : 'es_ES'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={description} />

    <!-- Theme color (both schemes) -->
    <meta name="theme-color" content="#1A1A18" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#F2F0ED" media="(prefers-color-scheme: light)" />

    {jsonLdBlocks.map((block) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(block)} />
    ))}
  </head>
  <body>
    <a href="#main" class="skip-link">{dict.a11y.skip}</a>
    <Header
      locale={locale}
      dict={dict}
      altHref={absolute(localePath(altLocale, canonicalPath))}
      altLocale={altLocale}
    />
    <main id="main">
      <span id="top"></span>
      <slot />
    </main>
    <Footer locale={locale} dict={dict} />

    <script>
      import '../scripts/landing.js';
    </script>
  </body>
</html>
