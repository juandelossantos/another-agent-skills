---
import Icon from './Icon.astro';
import { SITE } from '../config';
import { docsHome } from '../docs/paths';
import { blogHome } from '../blog/paths';
import { localePath } from '../i18n/routes';
import type { Dictionary, Locale } from '../i18n';

interface Props {
  locale: Locale;
  dict: Dictionary;
}

const { locale, dict } = Astro.props;

// Landing-aware anchors: the footer is reused on the blog, so `#section` links
// must resolve to the landing home from any page.
const home = localePath(locale);
const links = [
  { href: `${home}#flow`, label: dict.nav.flow },
  { href: `${home}#harness`, label: dict.nav.harness },
  { href: `${home}#enforcement`, label: dict.nav.enforcement },
  { href: `${home}#skills`, label: dict.nav.skills },
  { href: `${home}#workflows`, label: dict.nav.workflows },
  { href: `${home}#faq`, label: dict.nav.faq },
];
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__links">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
      <a href={blogHome(locale)}>{dict.nav.blog}</a>
      <a href={docsHome(locale)}>{dict.footer.docs}</a>
      <a href={SITE.github} target="_blank" rel="noopener">
        <span>{dict.footer.github}</span>
        <Icon name="external-link" />
      </a>
    </div>
    <p class="footer__copy">{dict.footer.copy}</p>
  </div>
</footer>
