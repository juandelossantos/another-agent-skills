---
import type { Dictionary } from '../i18n';

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;

// Rendered as static text so it is fully visible with JS off / reduced motion.
// The landing script re-types it only when motion is allowed.
const commands = [
  { channel: 'git', text: dict.terminal.cmd1, recommended: false },
  { channel: 'curl', text: dict.terminal.cmd2, recommended: false },
  { channel: 'npm', text: dict.terminal.cmd3, recommended: true },
];
---

<div class="terminal" data-terminal>
  <div class="terminal__bar">
    <span class="terminal__dot terminal__dot--r" aria-hidden="true"></span>
    <span class="terminal__dot terminal__dot--y" aria-hidden="true"></span>
    <span class="terminal__dot terminal__dot--g" aria-hidden="true"></span>
    <span class="terminal__title">{dict.hero.terminalTitle}</span>
  </div>
  <div class="terminal__body">
    <div class="terminal__hint">{dict.terminal.pickOne}</div>
    <div class="terminal__lines" data-terminal-lines>
      {commands.map((cmd) => (
        <div class="terminal__tline" data-channel={cmd.channel} data-recommended={cmd.recommended ? 'true' : undefined}>
          <span class="terminal__chan">{cmd.channel}</span>
          <span class="terminal__prompt">~ $</span>
          <span class="terminal__typing" tabindex="0">{cmd.text}</span>
          {cmd.recommended && <span class="terminal__rec">{dict.terminal.recommended}</span>}
        </div>
      ))}
    </div>
    <div class="terminal__output" data-terminal-output>
      <div class="terminal__out-line terminal__out-line--info">{dict.terminal.detected}</div>
      <div class="terminal__out-line">{dict.terminal.installed}</div>
      <div class="terminal__out-line">{dict.terminal.done}</div>
      <div class="terminal__out-line terminal__out-line--muted">{dict.terminal.channels}</div>
    </div>
  </div>
</div>
