---
interface Props {
  index: number;
  text: string;
  /** Stable id used by the loop animation (data-step). */
  stepId: string;
}

const { index, text, stepId } = Astro.props;
---

<li class="step" data-step={stepId}>
  <span class="step__idx" aria-hidden="true">{String(index).padStart(2, '0')}</span>
  <span>{text}</span>
</li>
