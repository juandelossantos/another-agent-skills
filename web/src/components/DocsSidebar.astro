---
import Icon from './Icon.astro';
import { VERSION } from '../config';
import { docsHref } from '../docs/paths';
import type { DocEntry, DocGroup } from '../docs/nav';
import { docSlug } from '../docs/nav';
import type { DocsDictionary } from '../i18n/docs';
import type { Locale } from '../i18n';
import { localePath } from '../i18n/routes';

interface Props {
  locale: Locale;
  dict: DocsDictionary;
  groups: DocGroup[];
  activeSlug: string;
}

const { locale, dict, groups, activeSlug } = Astro.props;
const homeHref = localePath(locale, '');

/** Sections that render as a collapsible native <details> group. */
const COLLAPSIBLE = new Set(['reference']);
---

<aside class="docs-sidebar" id="docs-sidebar" data-sidebar aria-label={dict.a11y.sidebar}>
  <div class="docs-sidebar__head">
    <a class="docs-sidebar__brand" href={homeHref} aria-label={dict.nav.home}>
      <span class="header__logo-mark" aria-hidden="true">///</span>
      <span class="docs-sidebar__brand-text">Another Agent Skills</span>
    </a>
    <p class="docs-sidebar__sub">{dict.nav.docs}</p>
  </div>

  <nav class="docs-nav" aria-label={dict.a11y.docsNav}>
    {groups.map((group) => {
      const label = dict.sections[group.id];
      const links = (
        <ul class="docs-nav__list">
          {group.docs.map((entry: DocEntry) => {
            const slug = docSlug(entry);
            const active = slug === activeSlug;
            return (
              <li>
                <a
                  class:list={['docs-nav__link', active && 'docs-nav__link--active']}
                  href={docsHref(locale, slug)}
                  aria-current={active ? 'page' : undefined}
                >
                  {entry.data.title}
                </a>
              </li>
            );
          })}
        </ul>
      );

      return COLLAPSIBLE.has(group.id) ? (
        <details class="docs-nav__group" open={group.docs.some((d) => docSlug(d) === activeSlug)}>
          <summary class="docs-nav__group-summary">
            <Icon name="chevron-right" class="docs-nav__chevron" />
            <span>{label}</span>
          </summary>
          {links}
        </details>
      ) : (
        <div class="docs-nav__group-plain">
          <p class="docs-nav__section">{label}</p>
          {links}
        </div>
      );
    })}
  </nav>

  <div class="docs-sidebar__foot">
    <span class="chip docs-version">
      <span class="docs-version__dot" aria-hidden="true"></span>
      <span>{VERSION}</span>
    </span>
    <span class="docs-sidebar__foot-label">{dict.versionLabel}</span>
  </div>
</aside>
