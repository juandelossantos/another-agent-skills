---
import Icon from './Icon.astro';
import type { IconName } from '../icons';

interface Props {
  label?: string;
  /** Base chip variant. */
  variant?: 'agent' | 'more' | 'hue' | 'level' | 'status';
  /** Adds the `chip--soon` modifier (used with `status`). */
  soon?: boolean;
  /** Lifecycle hue token, e.g. `define` (sets --h / --h-dim). */
  hue?: string;
  /** For `level` chips: on / off / later. */
  state?: 'on' | 'off' | 'later';
  /** Optional leading icon. */
  icon?: IconName;
  class?: string;
}

const { label, variant, soon, hue, state, icon, class: className } = Astro.props;
const classes = ['chip'];
if (variant) classes.push(`chip--${variant}`);
if (soon) classes.push('chip--soon');
if (className) classes.push(className);
---

<span
  class={classes.join(' ')}
  data-hue={hue}
  data-on={state === 'on' ? true : undefined}
  data-off={state === 'off' ? true : undefined}
  data-later={state === 'later' ? true : undefined}
>
  {icon && <Icon name={icon} />}
  {label && <span>{label}</span>}
  <slot />
</span>
