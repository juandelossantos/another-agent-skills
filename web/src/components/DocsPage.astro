---
import DocsLayout from '../layouts/DocsLayout.astro';
import SkillsCatalog from './SkillsCatalog.astro';
import { loadDoc, docSlug } from '../docs/nav';
import { buildDocsJsonLd } from '../docs/seo';
import { docsHome, docsHref } from '../docs/paths';
import { getDocsDictionary } from '../i18n/docs';
import { absoluteUrl } from '../site';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
  slug: string;
  /** Render the "browse the docs" card grid (docs index only). */
  showIndex?: boolean;
}

const { locale, slug, showIndex = false } = Astro.props;

const { entry, Content, headings, groups, prev, next, docs } = await loadDoc(locale, slug);
const dict = getDocsDictionary(locale);

const abs = absoluteUrl;
const homeUrl = abs(docsHome(locale));

const jsonLd = buildDocsJsonLd({
  locale,
  title: entry.data.title,
  description: entry.data.description,
  sectionLabel: dict.sections[entry.data.section],
  homeUrl,
  sectionUrl: `${homeUrl}#${entry.data.section}`,
  pageUrl: abs(docsHref(locale, slug)),
});
---

<DocsLayout
  locale={locale}
  slug={slug}
  entry={entry}
  Content={Content}
  headings={headings}
  groups={groups}
  prev={prev}
  next={next}
  jsonLd={jsonLd}
>
  {showIndex && (
    <>
      <h2>{dict.index.browse}</h2>
      <div class="docs-cards">
        {docs
          .filter((doc) => docSlug(doc) !== 'overview')
          .map((doc) => (
            <a class="docs-card" href={docsHref(locale, docSlug(doc))}>
              <span class="docs-card__title">{doc.data.title}</span>
              <span class="docs-card__desc">{doc.data.description}</span>
            </a>
          ))}
      </div>
    </>
  )}

  {slug === 'skills' && <SkillsCatalog locale={locale} />}
</DocsLayout>
